{
  "name": "taskmanagerapi",
  "version": "1.0.0",
  "description": "A RESTful API for managing user-owned tasks, built as a learning project to explore API design, HTTP semantics, authentication, validation, pagination, and backend development.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HrishavSaha/TaskManagerAPI.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/HrishavSaha/TaskManagerAPI/issues"
  },
  "homepage": "https://github.com/HrishavSaha/TaskManagerAPI#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
