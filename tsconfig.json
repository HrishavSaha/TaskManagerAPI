{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
  },
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
